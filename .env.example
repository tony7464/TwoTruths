# npm run setup creates .env with a random SECRET_KEY when .env is missing.
# You do not need to copy this file to run the app locally.
#
# SECRET_KEY is generated by setup. It is required when FLASK_DEBUG is off.
# Set your own in .env if you want:
# SECRET_KEY=replace-with-a-long-random-string
#
# DATABASE_URI is optional. The database defaults to server/instance/app.db.
# Set DATABASE_URI only to use a different database.
# postgres:// is accepted and rewritten to postgresql://.
# psycopg2-binary is installed, so a PostgreSQL URL is accepted.
# Only SQLite is tested in this project.
# DATABASE_URI=sqlite:///app.db
#
# DATABASE_URL is used when DATABASE_URI is unset (Render and Heroku set this).
#
# CORS_ORIGINS is optional. Comma-separated. Defaults to the Vite dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# TRUST_PROXY=1 when the app is behind one reverse proxy, so login limits see
# the real client in X-Forwarded-For. Leave it unset on your own computer.
# TRUST_PROXY=1
#
# CLIENT_DIST is optional. Path to the built React files. Default is client/dist.
# Leave it unset in development. Vite serves the client, and Flask serves this
# folder only when it contains index.html.
# CLIENT_DIST=client/dist
