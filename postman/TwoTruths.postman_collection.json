{
  "info": {
    "name": "TwoTruths",
    "description": "Every API route. baseUrl defaults to the Flask server. Postman and newman store the session cookie. Usernames are new each run, so demo accounts are not used. One failed login and one failed account deletion stay under the limit of 5 failures per username and IP per 60 seconds. Signup allows 10 attempts per IP per minute; this collection sends 4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5555"
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "pm.test('ok', function () { pm.expect(pm.response.json().ok).to.eql(true); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Signup",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var stamp = Date.now();",
              "pm.collectionVariables.set('userA', 'a' + stamp);",
              "pm.collectionVariables.set('userAOtherCase', 'A' + stamp);",
              "pm.collectionVariables.set('userB', 'b' + stamp);",
              "pm.collectionVariables.set('userC', 'c' + stamp);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('userAId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userA}}\",\n  \"password\": \"password123\",\n  \"bio\": \"Hello\"\n}"
        },
        "url": "{{baseUrl}}/api/signup"
      }
    },
    {
      "name": "Signup same name different case",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409', function () { pm.response.to.have.status(409); });",
              "pm.test('error', function () { pm.expect(pm.response.json()).to.have.property('error'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/signup",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{userAOtherCase}}\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
      "name": "Check session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', function () { pm.response.to.have.status(200); });",
              "pm.test('name', function () {",
              "  pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('userA'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/check_session"
      }
    },
