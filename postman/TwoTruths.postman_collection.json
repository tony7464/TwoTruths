          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[]"
        },
        "url": "{{baseUrl}}/api/login"
      }
    },
    {
      "name": "Create statements with bad input",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', function () { pm.response.to.have.status(400); });",
