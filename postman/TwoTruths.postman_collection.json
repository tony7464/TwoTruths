    {
      "name": "Create statements",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', function () { pm.response.to.have.status(201); });",
              "var rows = pm.response.json();",
              "pm.collectionVariables.set('statementId', rows[0].id);",
              "pm.collectionVariables.set('truthId', rows.find(function (row) { return row.is_lie === false; }).id);",
              "pm.collectionVariables.set('lieId', rows.find(function (row) { return row.is_lie === true; }).id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"statements\": [\n    {\"content\": \"I like rain.\", \"is_lie\": false},\n    {\"content\": \"I own a boat.\", \"is_lie\": true},\n    {\"content\": \"I drink tea.\", \"is_lie\": false}\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/statements"
      }
    },
